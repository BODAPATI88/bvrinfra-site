/* ============================================================
   BVRINFRA — style.css
   Theme : Precision Dark / Platform Engineering
   Fonts : Syne (display) + JetBrains Mono (code)
   Note  : Fonts loaded via <link> in HTML only — no @import.
   ============================================================ */

/* ── Variables ──────────────────────────────────────────────── */
:root {
  --bg-0:       #060a0e;
  --bg-1:       #0b1118;
  --bg-2:       #101820;
  --bg-3:       #151f2a;
  --border:     #1a2a3a;
  --border-hi:  #253850;
  --cyan:       #00d4ff;
  --cyan-glow:  rgba(0,212,255,0.10);
  --green:      #34d399;
  --purple:     #a78bfa;
  --orange:     #fb923c;
  --text-0:     #eaf4f8;
  --text-1:     #7fa4bc;
  --text-2:     #3d5a70;
  --mono:       'JetBrains Mono', monospace;
  --sans:       'Syne', sans-serif;
  --nav-h:      56px;
  --radius:     8px;
  --radius-lg:  14px;
  --radius-xl:  20px;
  --ease:       cubic-bezier(.22,1,.36,1);
  --transition: 180ms ease;
}

/* ── Reset ──────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
body {
  background: var(--bg-0);
  color: var(--text-0);
  font-family: var(--mono);
  font-size: 14px;
  line-height: 1.6;
  min-height: 100vh;
  overflow-x: hidden;
}
a { color: var(--cyan); text-decoration: none; }
button { cursor: pointer; font-family: inherit; border: none; background: none; }
strong { color: var(--text-0); }

/* Scanlines */
body::before {
  content: '';
  position: fixed; inset: 0;
  background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.03) 2px, rgba(0,0,0,0.03) 4px);
  pointer-events: none; z-index: 9999;
}

/* ── Layout ─────────────────────────────────────────────────── */
.container { max-width: 1060px; margin: 0 auto; padding: 0 24px; }

/* ── Nav ────────────────────────────────────────────────────── */
#site-header {
  position: sticky; top: 0; z-index: 200;
  background: rgba(6,10,14,0.88);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--border);
}
.nav-inner { display: flex; align-items: center; justify-content: space-between; height: var(--nav-h); }
.nav-brand { display: flex; align-items: center; gap: 8px; }
.nav-logo {
  width: 28px; height: 28px; border-radius: 7px;
  background: linear-gradient(135deg,#00d4ff 0%,#2563eb 100%);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--sans); font-weight: 900; font-size: 13px; color: #fff; flex-shrink: 0;
}
.nav-wordmark { font-family: var(--sans); font-weight: 700; font-size: 14px; color: var(--text-0); letter-spacing: 0.05em; }
.nav-domain { font-size: 11px; color: var(--text-2); letter-spacing: 0.04em; display: none; }
@media (min-width: 560px) { .nav-domain { display: block; } }

.nav-tabs { display: flex; gap: 2px; }
.nav-tab {
  padding: 6px 13px; border-radius: 8px; font-size: 12px; font-weight: 600;
  color: var(--text-1); letter-spacing: 0.02em; border: 1px solid transparent;
  transition: color var(--transition), background var(--transition), border-color var(--transition);
}
.nav-tab:hover { color: var(--text-0); }
.nav-tab.active { background: rgba(0,212,255,0.10); color: var(--cyan); border-color: rgba(0,212,255,0.25); }

.mobile-menu-btn { display: none; flex-direction: column; gap: 5px; padding: 4px; }
.mobile-menu-btn span { display: block; width: 22px; height: 2px; background: var(--text-1); border-radius: 2px; transition: var(--transition); }
@media (max-width: 600px) { .nav-tabs { display: none; } .mobile-menu-btn { display: flex; } }

.mobile-drawer { display: none; flex-direction: column; padding: 8px 16px 14px; gap: 2px; border-top: 1px solid var(--border); background: rgba(6,10,14,0.97); }
.mobile-drawer.open { display: flex; }
.mobile-drawer .nav-tab { text-align: left; padding: 10px 14px; border-radius: var(--radius); }

/* ── Pages ──────────────────────────────────────────────────── */
.page { display: none; animation: page-in 0.3s var(--ease); }
.page.active { display: block; }
@keyframes page-in { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }

/* ══ HERO ═══════════════════════════════════════════════════════ */
.hero {
  position: relative; min-height: calc(88vh - var(--nav-h));
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  text-align: center; padding: 80px 24px 120px; overflow: hidden;
}
.hero-grid-bg {
  position: absolute; inset: 0;
  background-image: linear-gradient(rgba(0,212,255,0.035) 1px,transparent 1px),linear-gradient(90deg,rgba(0,212,255,0.035) 1px,transparent 1px);
  background-size: 48px 48px;
}
.hero-glow {
  position: absolute; top:35%; left:50%; width:520px; height:300px; border-radius:50%;
  background: radial-gradient(ellipse,rgba(0,212,255,0.06) 0%,transparent 70%);
  transform: translate(-50%,-50%); pointer-events: none;
}
.hero-content { position:relative; z-index:2; max-width:700px; padding-bottom:48px; }
.hero-badge {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 6px 14px; border-radius: 999px;
  background: rgba(52,211,153,0.08); border: 1px solid rgba(52,211,153,0.22);
  color: var(--green); font-size: 11px; font-weight: 600; letter-spacing: 0.04em; margin-bottom: 28px;
}
.hero-headline {
  font-family: var(--sans); font-weight: 900;
  font-size: clamp(34px,9vw,76px); line-height: 0.95;
  letter-spacing: -0.03em; color: var(--text-0); margin-bottom: 22px;
}
.gradient-text {
  background: linear-gradient(90deg,#00d4ff 0%,#3b82f6 100%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.hero-sub { font-size: 15px; color: var(--text-1); line-height: 1.7; max-width: 520px; margin: 0 auto 36px; }
.hero-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

.btn-primary {
  padding: 13px 26px; border-radius: var(--radius-lg); background: var(--cyan);
  color: #060a0e; font-family: var(--sans); font-weight: 700; font-size: 14px;
  transition: background var(--transition), transform 120ms var(--ease), box-shadow var(--transition);
}
.btn-primary:hover { background: #33deff; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,212,255,0.25); }
.btn-primary:active { transform: scale(0.97); }

.btn-ghost {
  padding: 12px 24px; border-radius: var(--radius-lg);
  border: 1px solid var(--border-hi); color: var(--text-1);
  font-family: var(--sans); font-weight: 600; font-size: 14px;
  transition: border-color var(--transition), color var(--transition);
}
.btn-ghost:hover { border-color: var(--text-1); color: var(--text-0); }

.hero-domains {
  position: absolute; bottom: 28px; left: 0; right: 0;
  display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; z-index: 2; padding: 0 24px;
}
.domain-pill {
  font-size: 11px; font-family: var(--mono); padding: 5px 12px; border-radius: 999px;
  background: rgba(13,17,24,0.80); border: 1px solid var(--border-hi); color: var(--text-2); white-space: nowrap;
}

/* ══ CAREER JOURNEY BAR ═══════════════════════════════════════ */
.journey-bar {
  border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
  background: var(--bg-1); padding: 12px 24px; overflow-x: auto;
}
.journey-inner {
  display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
  justify-content: center; max-width: 1060px; margin: 0 auto;
}
.journey-step { font-family: var(--mono); font-size: 11px; color: var(--text-2); letter-spacing: 0.04em; white-space: nowrap; }
.journey-step.active { color: var(--cyan); font-weight: 700; }
.journey-arrow { color: var(--text-2); font-size: 11px; opacity: 0.5; }

/* ══ STATS BAR ════════════════════════════════════════════════ */
.stats-bar { border-bottom: 1px solid var(--border); background: rgba(11,17,24,0.6); }
.stats-grid { display: grid; grid-template-columns: repeat(2,1fr); max-width: 1060px; margin: 0 auto; }
@media (min-width: 600px) { .stats-grid { grid-template-columns: repeat(4,1fr); } }

.stat-cell { padding: 28px 24px; text-align: center; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); }
.stat-cell:nth-child(2n) { border-right: none; }
@media (min-width: 600px) {
  .stat-cell { border-bottom: none; }
  .stat-cell:nth-child(2n) { border-right: 1px solid var(--border); }
  .stat-cell:last-child { border-right: none; }
}
.stat-number { font-family: var(--sans); font-weight: 900; font-size: 38px; color: var(--text-0); line-height: 1; letter-spacing: -0.02em; margin-bottom: 6px; }
.stat-sfx { font-size: 0.65em; }
.stat-label { font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-2); }

/* ══ PLATFORM HIGHLIGHTS ══════════════════════════════════════ */
.highlights-section { padding: 72px 0 80px; border-top: 1px solid var(--border); }
.highlights-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 12px; }
@media (min-width: 640px)  { .highlights-grid { grid-template-columns: repeat(3,1fr); } }
@media (min-width: 960px)  { .highlights-grid { grid-template-columns: repeat(5,1fr); } }

.hl-card {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 14px 16px; border-radius: var(--radius-lg);
  border: 1px solid var(--border); background: var(--bg-1);
  transition: border-color var(--transition), background var(--transition), transform 150ms var(--ease);
}
.hl-card:hover { border-color: rgba(0,212,255,0.25); background: var(--bg-2); transform: translateY(-2px); }
.hl-check { font-size: 14px; color: var(--green); flex-shrink: 0; font-weight: 700; margin-top: 1px; line-height: 1.4; }
.hl-title { font-family: var(--sans); font-weight: 700; font-size: 12px; color: var(--text-0); line-height: 1.3; margin-bottom: 3px; }
.hl-desc { font-size: 10px; color: var(--text-2); line-height: 1.5; }

/* ══ GITOPS FLOW SVG ══════════════════════════════════════════ */
.gitops-section { padding: 72px 0 80px; background: var(--bg-1); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
.gitops-wrap { display: flex; flex-direction: column; align-items: center; gap: 24px; }
.gitops-svg { width: 100%; max-width: 560px; height: auto; display: block; overflow: visible; }

/* ══ STACK SECTION ════════════════════════════════════════════ */
.stack-section { padding: 56px 0; }
.eyebrow { font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-2); margin-bottom: 24px; }
.eyebrow.center { text-align: center; }
.stack-grid { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
.stack-pill {
  display: flex; align-items: center; gap: 10px; padding: 11px 18px;
  border-radius: var(--radius-lg); background: rgba(16,24,32,0.7); border: 1px solid var(--border);
  transition: border-color var(--transition), background var(--transition), transform 120ms var(--ease);
}
.stack-pill:hover { border-color: var(--border-hi); background: var(--bg-3); transform: translateY(-2px); }
.stack-icon { font-size: 18px; line-height: 1; }
.stack-name { font-family: var(--sans); font-weight: 600; font-size: 13px; color: var(--text-0); line-height: 1.2; }
.stack-role { font-size: 10px; color: var(--text-2); margin-top: 1px; }

/* ══ SHARED SECTION LAYOUT ════════════════════════════════════ */
.content-section { padding: 72px 0 80px; border-top: 1px solid var(--border); }
.section-head { margin-bottom: 48px; }
.section-head.center { text-align: center; }
.section-title { font-family: var(--sans); font-weight: 900; font-size: clamp(26px,4vw,36px); color: var(--text-0); letter-spacing: -0.02em; margin-bottom: 8px; }
.section-sub { font-size: 13px; color: var(--text-1); }

/* ══ PROJECT CARDS ════════════════════════════════════════════ */
.projects-grid { display: grid; grid-template-columns: 1fr; gap: 18px; }
@media (min-width: 640px) { .projects-grid { grid-template-columns: repeat(2,1fr); } }
@media (min-width: 960px) { .projects-grid { grid-template-columns: repeat(3,1fr); } }

.project-card {
  position: relative; border-radius: var(--radius-xl); border: 1px solid var(--border);
  background: rgba(11,17,24,0.85); overflow: hidden; display: flex; flex-direction: column;
  transition: transform 200ms var(--ease), border-color var(--transition), box-shadow var(--transition);
}
.project-card:hover { transform: translateY(-4px); border-color: var(--border-hi); box-shadow: 0 16px 40px rgba(0,0,0,0.4); }
.card-top-bar { height: 3px; background: var(--accent,#00d4ff); }
.card-header { padding: 18px 20px 12px; display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.card-meta { flex: 1; min-width: 0; }
.card-title-row { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
.card-icon { font-size: 20px; }
.card-tag { font-size: 10px; font-weight: 700; letter-spacing: 0.10em; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; background: var(--bg-2); color: var(--text-2); border: 1px solid var(--border); }
.card-title { font-family: var(--sans); font-weight: 700; font-size: 16px; color: var(--text-0); line-height: 1.25; margin-bottom: 4px; }
.card-headline { font-size: 12px; color: var(--text-1); line-height: 1.5; }
.card-status {
  flex-shrink: 0; font-size: 10px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;
  padding: 4px 10px; border-radius: 999px;
  color: var(--accent,#00d4ff); border: 1px solid var(--accent,#00d4ff);
  background: color-mix(in srgb, var(--accent,#00d4ff) 10%, transparent); white-space: nowrap;
}
.card-bullets { padding: 0 20px 12px; flex: 1; }
.card-bullets ul { list-style: none; display: flex; flex-direction: column; gap: 7px; }
.card-bullets li { display: flex; align-items: flex-start; gap: 8px; font-size: 12px; color: var(--text-1); line-height: 1.5; }
.bullet-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--accent,#00d4ff); flex-shrink: 0; margin-top: 6px; }
.card-layers { padding: 10px 20px 14px; display: flex; flex-wrap: wrap; gap: 6px; border-top: 1px solid var(--border); }
.layer-pill { font-size: 10px; font-family: var(--mono); padding: 3px 9px; border-radius: 4px; background: var(--bg-2); color: var(--text-2); letter-spacing: 0.02em; }
.card-footer { padding: 10px 20px; background: rgba(255,255,255,0.025); border-top: 1px solid var(--border); }
.card-domain { font-size: 11px; font-family: var(--mono); color: var(--text-2); }

/* ══ PLATFORM EVIDENCE ════════════════════════════════════════ */
.evidence-section { padding-top: 0; border-top: 1px solid var(--border); }
.evidence-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 16px; }
@media (max-width: 600px) { .evidence-grid { grid-template-columns: 1fr; } }

.evidence-card {
  border-radius: var(--radius-lg); border: 1px solid var(--border);
  background: var(--bg-1); overflow: hidden; cursor: pointer;
  transition: border-color var(--transition), transform 150ms var(--ease), box-shadow var(--transition);
}
.evidence-card:hover { border-color: var(--border-hi); transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.4); }
.evidence-card:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; }

.evidence-img-wrap { position: relative; width: 100%; aspect-ratio: 16/9; background: var(--bg-2); overflow: hidden; }
.evidence-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 300ms var(--ease); }
.evidence-card:hover .evidence-img { transform: scale(1.04); }

.evidence-placeholder {
  position: absolute; inset: 0; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 10px;
  background: var(--bg-2); color: var(--text-2); font-size: 11px; font-family: var(--mono);
}
.evidence-placeholder-icon { font-size: 28px; }

.evidence-zoom-hint {
  position: absolute; bottom: 8px; right: 8px;
  font-size: 10px; font-family: var(--mono); font-weight: 700;
  color: var(--cyan); background: rgba(6,10,14,0.82);
  border: 1px solid rgba(0,212,255,0.25); border-radius: 4px;
  padding: 3px 8px; opacity: 0; transition: opacity 200ms ease; pointer-events: none;
}
.evidence-card:hover .evidence-zoom-hint { opacity: 1; }
@media (max-width: 600px) { .evidence-zoom-hint { opacity: 1; } }

.evidence-meta { padding: 14px 16px; }
.evidence-title { font-family: var(--sans); font-weight: 700; font-size: 13px; color: var(--text-0); margin-bottom: 4px; }
.evidence-desc { font-size: 11px; color: var(--text-1); line-height: 1.5; }

/* ══ ARCH DIAGRAM IMAGE SECTION ═══════════════════════════════ */
.arch-diagram-section { padding: 56px 24px 0; background: var(--bg-0); }
.arch-diagram-container {
  max-width: 1400px; margin: 0 auto;
  border-radius: var(--radius-xl); border: 1px solid var(--border-hi);
  background: var(--bg-1); overflow: hidden;
  box-shadow: 0 0 0 1px rgba(0,212,255,0.06), 0 0 40px rgba(0,212,255,0.05), 0 24px 64px rgba(0,0,0,0.5);
  transition: box-shadow 300ms ease, border-color 300ms ease;
}
.arch-diagram-container:hover { border-color: rgba(0,212,255,0.25); box-shadow: 0 0 0 1px rgba(0,212,255,0.12), 0 0 60px rgba(0,212,255,0.08), 0 32px 80px rgba(0,0,0,0.55); }
.arch-diagram-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; padding: 22px 26px 18px; border-bottom: 1px solid var(--border); }
.arch-diagram-title { font-family: var(--sans); font-weight: 800; font-size: clamp(17px,2.5vw,22px); color: var(--text-0); letter-spacing: -0.02em; margin-bottom: 5px; }
.arch-diagram-subtitle { font-size: 12px; color: var(--text-1); line-height: 1.55; max-width: 580px; }
.arch-expand-btn {
  display: flex; align-items: center; gap: 7px; padding: 8px 14px;
  border-radius: var(--radius); border: 1px solid var(--border-hi);
  background: var(--bg-2); color: var(--text-1); font-size: 12px; font-weight: 600;
  white-space: nowrap; flex-shrink: 0;
  transition: border-color var(--transition), color var(--transition), background var(--transition);
}
.arch-expand-btn:hover { border-color: var(--cyan); color: var(--cyan); background: var(--cyan-glow); }

.arch-img-wrap { position: relative; width: 100%; line-height: 0; cursor: zoom-in; overflow: hidden; background: #070d14; }
.arch-diagram-img { width: 100%; height: auto; display: block; transition: transform 400ms var(--ease), filter 300ms ease; will-change: transform; }
.arch-img-wrap:hover .arch-diagram-img { transform: scale(1.008); filter: brightness(1.05); }

.arch-img-overlay { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0); transition: background 250ms ease; }
.arch-img-wrap:hover .arch-img-overlay { background: rgba(0,0,0,0.18); }
.arch-img-overlay:focus-visible { outline: 2px solid var(--cyan); outline-offset: -2px; }

.arch-zoom-hint {
  display: flex; align-items: center; gap: 7px; padding: 8px 16px; border-radius: 999px;
  background: rgba(6,10,14,0.82); border: 1px solid rgba(0,212,255,0.3); color: var(--cyan);
  font-size: 12px; font-weight: 600;
  opacity: 0; transform: translateY(6px);
  transition: opacity 250ms ease, transform 250ms ease;
  backdrop-filter: blur(8px); pointer-events: none;
}
.arch-img-wrap:hover .arch-zoom-hint { opacity: 1; transform: translateY(0); }

.arch-diagram-meta { display: flex; flex-wrap: wrap; gap: 8px; padding: 14px 26px; border-top: 1px solid var(--border); background: rgba(0,0,0,0.2); }
.arch-meta-pill { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-family: var(--mono); color: var(--text-2); padding: 4px 12px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg-2); letter-spacing: 0.03em; }

@media (max-width: 600px) {
  .arch-diagram-header { padding: 16px 18px 14px; flex-direction: column; }
  .arch-expand-btn { align-self: flex-start; }
  .arch-diagram-meta { padding: 12px 18px; }
  .arch-zoom-hint { font-size: 11px; padding: 7px 13px; opacity: 1; transform: translateY(0); }
  .arch-img-overlay { background: rgba(0,0,0,0.04); }
}

/* ══ ARCH FLOW DIAGRAM (CSS layers) ══════════════════════════ */
.arch-layout { display: grid; grid-template-columns: 1fr; gap: 32px; }
@media (min-width: 900px) { .arch-layout { grid-template-columns: 1fr 1fr; align-items: start; } }

.arch-diagram { position: relative; display: flex; flex-direction: column; gap: 0; }
.arch-flow-line {
  position: absolute; left: 50%; top: 0; bottom: 0; width: 1px;
  background: linear-gradient(to bottom, transparent, var(--border) 20%, var(--border) 80%, transparent);
  transform: translateX(-50%); z-index: 0; pointer-events: none;
}
.arch-layer { position: relative; z-index: 1; border-radius: var(--radius-lg); border: 1px solid var(--layer-border,rgba(0,212,255,0.28)); background: var(--layer-bg,rgba(0,212,255,0.07)); padding: 16px 18px; transition: transform 200ms var(--ease); }
.arch-layer:hover { transform: scaleX(1.02); }
.layer-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.layer-badge { font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--layer-color,var(--cyan)); background: var(--layer-bg,rgba(0,212,255,0.07)); border: 1px solid var(--layer-border,rgba(0,212,255,0.28)); padding: 3px 10px; border-radius: 999px; }
.layer-items { display: flex; flex-wrap: wrap; gap: 8px; }
.layer-item { font-size: 12px; color: var(--text-1); background: rgba(6,10,14,0.5); border: 1px solid var(--border); padding: 4px 12px; border-radius: 999px; }
.arch-arrow { text-align: center; color: var(--text-2); font-size: 11px; line-height: 1; padding: 4px 0; position: relative; z-index: 2; }

.arch-side { display: flex; flex-direction: column; gap: 16px; }
.arch-panel { border-radius: var(--radius-lg); border: 1px solid var(--border); background: rgba(11,17,24,0.7); padding: 20px; }
.arch-panel-title { font-family: var(--sans); font-weight: 700; font-size: 13px; color: var(--text-0); margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
.cyan-accent { color: var(--cyan); }
.green-accent { color: var(--green); }
.decision-list { display: flex; flex-direction: column; gap: 14px; }
.decision-item { display: flex; gap: 14px; align-items: flex-start; }
.decision-num { font-family: var(--mono); font-size: 11px; color: var(--cyan); flex-shrink: 0; margin-top: 2px; letter-spacing: 0.05em; }
.decision-item p { font-size: 12px; color: var(--text-1); line-height: 1.6; }
.endpoints-list { display: flex; flex-direction: column; gap: 10px; }
.endpoint-row { display: flex; align-items: center; gap: 8px; font-size: 12px; }
.endpoint-url { font-family: var(--mono); color: var(--cyan); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.endpoint-desc { color: var(--text-2); white-space: nowrap; }

/* ══ OBSERVABILITY SVG ════════════════════════════════════════ */
.obs-section { background: var(--bg-1); border-top: 1px solid var(--border); }
.obs-wrap { display: flex; flex-direction: column; align-items: center; gap: 24px; }
.obs-svg { width: 100%; max-width: 720px; height: auto; display: block; overflow: visible; }
.obs-badges { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
.obs-badge { font-size: 10px; font-family: var(--mono); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 4px 12px; border-radius: 999px; }
.obs-badge.cyan   { background: rgba(0,212,255,0.08);   border: 1px solid rgba(0,212,255,0.25);   color: var(--cyan); }
.obs-badge.purple { background: rgba(167,139,250,0.10); border: 1px solid rgba(167,139,250,0.3);  color: #a78bfa; }
.obs-badge.orange { background: rgba(251,146,60,0.10);  border: 1px solid rgba(251,146,60,0.3);   color: #fb923c; }
.obs-badge.green  { background: rgba(52,211,153,0.10);  border: 1px solid rgba(52,211,153,0.3);   color: var(--green); }

/* ══ LIGHTBOX MODAL ═══════════════════════════════════════════ */
.arch-modal {
  position: fixed; inset: 0; z-index: 1000;
  display: flex; align-items: center; justify-content: center;
  pointer-events: none; opacity: 0; transition: opacity 280ms var(--ease);
}
.arch-modal.open { opacity: 1; pointer-events: all; }
.arch-modal-backdrop { position: absolute; inset: 0; background: rgba(4,7,10,0.92); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); cursor: zoom-out; }
.arch-modal-inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; width: 100%; height: 100%; padding: 20px; }
.arch-modal-close {
  position: fixed; top: 16px; right: 16px; z-index: 2;
  width: 40px; height: 40px; border-radius: 50%;
  background: rgba(11,17,24,0.9); border: 1px solid var(--border-hi);
  color: var(--text-1); display: flex; align-items: center; justify-content: center;
  transition: background var(--transition), color var(--transition), border-color var(--transition);
  backdrop-filter: blur(8px);
}
.arch-modal-close:hover { background: var(--bg-3); color: var(--cyan); border-color: var(--cyan); }
.arch-modal-scroll {
  width: 100%; height: 100%; overflow: auto;
  display: flex; align-items: flex-start; justify-content: center;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: thin; scrollbar-color: var(--border-hi) transparent;
}
.arch-modal-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
.arch-modal-scroll::-webkit-scrollbar-thumb { background: var(--border-hi); border-radius: 3px; }
.arch-modal-img {
  max-width: 1400px; width: 100%; height: auto; display: block;
  border-radius: var(--radius-lg); border: 1px solid var(--border-hi);
  box-shadow: 0 0 80px rgba(0,212,255,0.08), 0 32px 80px rgba(0,0,0,0.6);
  touch-action: pinch-zoom; will-change: transform;
  transform: scale(0.97); transition: transform 300ms var(--ease);
}
.arch-modal.open .arch-modal-img { transform: scale(1); }
@media (max-width: 600px) { .arch-modal-img { max-width: none; width: auto; min-width: 100%; } }
.arch-modal-hint {
  position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%);
  font-size: 11px; font-family: var(--mono); color: var(--text-2);
  text-align: center; white-space: nowrap; pointer-events: none;
}

/* ══ CONTACT ══════════════════════════════════════════════════ */
.contact-cards { display: grid; grid-template-columns: 1fr; gap: 14px; max-width: 860px; margin: 0 auto 32px; }
@media (min-width: 500px) { .contact-cards { grid-template-columns: repeat(2,1fr); } }
@media (min-width: 760px) { .contact-cards { grid-template-columns: repeat(4,1fr); } }

.contact-card {
  display: flex; flex-direction: column; align-items: center; padding: 24px 16px;
  border-radius: var(--radius-lg); border: 1px solid var(--border);
  background: rgba(11,17,24,0.7); color: var(--text-0); text-align: center; text-decoration: none;
  transition: border-color var(--transition), background var(--transition), transform 150ms var(--ease);
}
.contact-card:hover { border-color: rgba(0,212,255,0.35); background: var(--bg-2); transform: translateY(-3px); }
.contact-card:hover .contact-val { color: var(--cyan); }
.contact-icon { font-size: 20px; font-family: var(--sans); font-weight: 800; color: var(--text-1); margin-bottom: 10px; line-height: 1; }
.contact-label { font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-2); margin-bottom: 6px; }
.contact-val { font-family: var(--mono); font-size: 11px; color: var(--text-1); transition: color var(--transition); word-break: break-all; }

/* Contact detail grid */
.contact-details-grid { display: grid; grid-template-columns: 1fr; gap: 14px; max-width: 640px; margin: 0 auto 32px; }
@media (min-width: 640px) { .contact-details-grid { grid-template-columns: repeat(3,1fr); } }
.contact-detail-card { padding: 18px 20px; border-radius: var(--radius-lg); border: 1px solid var(--border); background: rgba(11,17,24,0.7); }
.cd-label { font-size: 11px; color: var(--text-2); margin-bottom: 10px; font-family: var(--mono); }
.cd-value { font-family: var(--sans); font-weight: 700; font-size: 15px; color: var(--text-0); }
.cd-tags { display: flex; flex-wrap: wrap; gap: 6px; }
.cd-tag { font-size: 10px; font-family: var(--mono); padding: 3px 10px; border-radius: 999px; background: var(--bg-2); border: 1px solid var(--border-hi); color: var(--cyan); }

.availability-pill { display: flex; align-items: center; gap: 8px; padding: 8px 18px; border-radius: 999px; background: var(--bg-2); border: 1px solid var(--border-hi); color: var(--text-2); font-size: 12px; margin: 0 auto; width: fit-content; }

/* ══ PULSE DOT ════════════════════════════════════════════════ */
.pulse-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--cyan); flex-shrink: 0; animation: pulse-beat 2s infinite; }
.pulse-dot.green { background: var(--green); box-shadow: 0 0 5px var(--green); }
.pulse-dot.sm { width: 6px; height: 6px; }
@keyframes pulse-beat { 0%,100% { opacity:1; transform:scale(1); } 50% { opacity:0.45; transform:scale(0.85); } }

/* ══ FOOTER ═══════════════════════════════════════════════════ */
footer { border-top: 1px solid var(--border); padding: 22px 24px; }
.footer-inner { max-width: 1060px; margin: 0 auto; text-align: center; }
.footer-mono { font-family: var(--mono); font-size: 11px; color: var(--text-2); letter-spacing: 0.04em; }

/* ══ RESUME ═══════════════════════════════════════════════════ */
.resume-skills-bar { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 36px; }
.rs-pill { font-size: 11px; font-family: var(--mono); padding: 5px 12px; border-radius: 999px; background: var(--bg-2); border: 1px solid var(--border-hi); color: var(--cyan); white-space: nowrap; }
.resume-block { border-radius: var(--radius-lg); border: 1px solid var(--border); background: var(--bg-1); padding: 22px 24px; margin-bottom: 16px; }
.resume-block.highlight-block { border-color: rgba(0,212,255,0.22); background: rgba(0,212,255,0.03); }
.resume-block-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 14px; flex-wrap: wrap; }
.resume-role { font-family: var(--sans); font-weight: 700; font-size: 15px; color: var(--text-0); }
.resume-at { font-weight: 400; color: var(--text-1); font-size: 14px; }
.resume-company { font-size: 12px; color: var(--cyan); margin-top: 2px; font-family: var(--mono); }
.resume-period { font-size: 11px; font-family: var(--mono); color: var(--text-2); white-space: nowrap; padding-top: 2px; }
.resume-bullets { list-style: none; display: flex; flex-direction: column; gap: 7px; margin-bottom: 16px; }
.resume-bullets li { font-size: 12px; color: var(--text-1); line-height: 1.6; padding-left: 14px; position: relative; }
.resume-bullets li::before { content: '→'; position: absolute; left: 0; color: var(--cyan); font-size: 11px; }
.resume-tags { display: flex; flex-wrap: wrap; gap: 6px; padding-top: 12px; border-top: 1px solid var(--border); }
.resume-tags span { font-size: 10px; font-family: var(--mono); padding: 3px 9px; border-radius: 4px; background: var(--bg-2); color: var(--text-2); border: 1px solid var(--border); }
@media (max-width: 600px) { .resume-block { padding: 16px; } .resume-block-header { gap: 6px; } }

/* ══ UTILITY ══════════════════════════════════════════════════ */
.sr-only {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}
.content-section.no-border { border-top: none; }
@supports not (background: color-mix(in srgb, red 10%, transparent)) { .card-status { background: rgba(0,0,0,0.25); } }
button:focus-visible, a:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; }
@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; } }


@media (max-width: 768px) {
  .hero {
    min-height: auto !important;
    justify-content: flex-start !important;
    padding: 30px 20px 30px !important;
  }

  .hero-content {
    padding-bottom: 12px !important;
  }

  .hero-headline {
    font-size: 42px !important;
    line-height: 1.05;
  }

  .hero-sub {
    font-size: 14px;
    line-height: 1.5;
  }

  .hero-domains {
    position: static !important;
    margin-top: 16px;
    padding: 0;
  }
}
